{
  "name": "@alexeyco/microspec",
  "version": "0.2.0",
  "description": "Task Contract — a task-scoped Micro-SDD flow for OpenCode and Pi: /microspec.brief turns a request into one executable TASK.md, /microspec.execute runs it through parallel subagent waves with evidence",
  "keywords": [
    "agents",
    "micro-sdd",
    "opencode",
    "opencode-plugin",
    "pi-package",
    "sdd",
    "skills",
    "task-contract",
    "workflow"
  ],
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./opencode/index.ts"
  },
  "files": [
    "agents",
    "core",
    "docs",
    "opencode",
    "pi",
    "skills",
    "index.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opencode/plugin": "^2.0.28",
    "yaml": "^2"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.1.0",
    "@types/node": "^26",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "pi": {
    "extensions": [
      "./pi/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexeyco/microspec.git"
  },
  "engines": {
    "node": ">=22.18"
  }
}
